# Copy the missing entries into .env.local; keep all secrets server-side.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SOLANA_MAINNET_RPC_URL=
JUPITER_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=862473
# Generate a strong random token, e.g. openssl rand -hex 32
TWEET_ADMIN_TOKEN=
CRON_SECRET=
# Confidential OAuth 2.0 web app credentials from the X developer console.
# Connect @lumenless through /admin/tweets; tokens are stored in the private database.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional alternative to the Connect X flow: seed an existing refresh token.
# X_REFRESH_TOKEN=

# Business OAuth export page (same X app). Generate the session key with openssl rand -hex 32.
BUSINESS_APP_URL=https://business.lumenless.com
BUSINESS_SESSION_SECRET=
# Optional initial user credentials exported by Business. The publisher subsequently rotates them in its private DB.
# X_ACCESS_TOKEN=
# X_REFRESH_TOKEN=
# X_TOKEN_EXPIRES_AT=
